<?xml version="1.0" encoding="utf-8" ?>
<component name="SearchScreen" extends="Group">
    <interface>
        <field id="catalog" type="array" onChange="onCatalogOrProfileChanged" />
        <field id="isKidsProfile" type="boolean" value="false" onChange="onCatalogOrProfileChanged" />
        <field id="selectedItem" type="assocarray" alwaysNotify="true" />
        <field id="requestNavFocus" type="boolean" alwaysNotify="true" />
        <field id="focusRequested" type="boolean" alwaysNotify="true" onChange="onFocusRequested" />
    </interface>

    <script type="text/brightscript" uri="pkg:/source/Config.brs" />
    <script type="text/brightscript" uri="pkg:/source/VideoSourceUtil.brs" />
    <script type="text/brightscript" uri="pkg:/source/FirebaseUtil.brs" />
    <script type="text/brightscript" uri="pkg:/components/SearchScreen.brs" />

    <children>
        <Rectangle width="1920" height="1080" color="0x080808FF" />

        <!-- Header -->
        <Label
            width="600"
            height="58"
            translation="[140, 46]"
            text="Search Notflix"
            font="font:LargeBoldSystemFont"
            color="0xF5F5F7FF" />

        <Label
            id="searchHint"
            width="900"
            height="34"
            translation="[140, 112]"
            text="Search movies, TV shows, genres, and keywords. Press Right for results, Left for menu."
            font="font:SmallestSystemFont"
            color="0xA0A3B1FF" />

        <!-- Left Column: MiniKeyboard + Clear Button -->
        <MiniKeyboard
            id="searchKeyboard"
            translation="[140, 174]"
            showTextEditBox="true"
            lowerCase="true" />

        <Group id="clearBtnGroup" translation="[140, 740]">
            <Rectangle id="clearBorder" width="460" height="64" color="0x2E2E3AFF" />
            <Rectangle id="clearBg" width="452" height="56" translation="[4, 4]" color="0x1A1A24FF" />
            <Label
                width="452"
                height="56"
                translation="[4, 4]"
                horizAlign="center"
                vertAlign="center"
                text="Clear Search"
                font="font:SmallBoldSystemFont"
                color="0xF5F5F7FF" />
        </Group>

        <!-- Right Column: Live Results Grid -->
        <Label
            id="resultsHeader"
            width="1100"
            height="42"
            translation="[720, 166]"
            text="Popular Titles"
            font="font:MediumBoldSystemFont"
            color="0xF5F5F7FF" />

        <Label
            id="emptyResultsLabel"
            width="1020"
            height="120"
            translation="[720, 320]"
            wrap="true"
            numLines="3"
            text=""
            font="font:SmallSystemFont"
            color="0xA0A3B1FF"
            visible="false" />

        <MarkupGrid
            id="resultsGrid"
            translation="[720, 224]"
            itemComponentName="PosterItem"
            numColumns="4"
            numRows="2"
            itemSize="[240, 360]"
            itemSpacing="[28, 28]"
            drawFocusFeedback="false"
            vertFocusAnimationStyle="floatingFocus" />
    </children>
</component>
