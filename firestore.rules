rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Helpers ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAccountOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // One-time Owner bootstrap check used only to anchor the trusted /owners/{uid} record
    // and maintain uninterrupted access for the existing Owner account.
    function isBootstrappedOwner() {
      return isSignedIn() &&
             ('email' in request.auth.token) &&
             request.auth.token.email.lower() == 'michael.tollackson82313@gmail.com';
    }

    // Trusted Platform Owner check (custom claim OR immutable /owners/{uid} record OR bootstrap)
    function isPlatformOwner() {
      return isSignedIn() && (
        request.auth.token.get('role', '') == 'owner' ||
        exists(/databases/$(database)/documents/owners/$(request.auth.uid)) ||
        isBootstrappedOwner()
      );
    }

    // Admin OR Owner check
    function isAdmin() {
      return isSignedIn() && (
        isPlatformOwner() ||
        request.auth.token.get('role', '') == 'admin' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Non-owner Admin only
    function isAdminOnly() {
      return isAdmin() && !isPlatformOwner();
    }

    function isTargetPlatformOwner(userId) {
      return exists(/databases/$(database)/documents/owners/$(userId)) ||
             (exists(/databases/$(database)/documents/users/$(userId)) &&
              get(/databases/$(database)/documents/users/$(userId)).data.get('role', '') == 'owner');
    }

    function isTargetAdmin(userId) {
      return exists(/databases/$(database)/documents/admins/$(userId)) ||
             (exists(/databases/$(database)/documents/users/$(userId)) &&
              get(/databases/$(database)/documents/users/$(userId)).data.get('role', '') == 'admin');
    }

    function isActivePublisherData(data) {
      return data.get('role', '') == 'publisher' &&
             data.get('publisherStatus', 'approved') == 'approved' &&
             data.get('isSuspended', false) == false;
    }

    function isApprovedPublisher() {
      return isSignedIn() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         isActivePublisherData(get(/databases/$(database)/documents/users/$(request.auth.uid)).data))
      );
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    // --- Validation Helpers ---
    function isValidUserAccount(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.email is string && data.email.size() <= 200 &&
             (!('phoneNumber' in data) || data.phoneNumber == null || (data.phoneNumber is string && data.phoneNumber.size() <= 40)) &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
             (!('photoUrl' in data) || data.photoUrl == null || (data.photoUrl is string && data.photoUrl.size() <= 1000)) &&
             data.role in ['viewer', 'member', 'publisher', 'admin', 'owner'] &&
             (!('publisherStatus' in data) || data.publisherStatus in ['none', 'pending', 'under_review', 'approved', 'rejected', 'suspended', 'revoked']) &&
             (!('publisherName' in data) || data.publisherName == null || (data.publisherName is string && data.publisherName.size() <= 120)) &&
             (!('publisherAppliedAt' in data) || data.publisherAppliedAt == null || data.publisherAppliedAt is timestamp) &&
             (!('isSuspended' in data) || data.isSuspended is bool) &&
             data.languagePreference is string && data.languagePreference.size() >= 1 && data.languagePreference.size() <= 40 &&
             data.autoplayNext is bool &&
             data.defaultQuality in ['Auto', '1080p', '720p', '480p'] &&
             data.subtitlesEnabled is bool &&
             data.subtitleSize in ['Small', 'Medium', 'Large'] &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidOwnerRecord(data) {
      return data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
             data.establishedBy is string && data.establishedBy.size() >= 1 && data.establishedBy.size() <= 128 &&
             isValidTimestamp(data.createdAt);
    }

    function isValidAdminRecord(data) {
      return data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
             data.grantedBy is string && data.grantedBy.size() >= 1 && data.grantedBy.size() <= 128 &&
             isValidTimestamp(data.createdAt);
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 40 &&
             data.avatarKey is string && data.avatarKey.size() >= 1 && data.avatarKey.size() <= 64 &&
             data.isKids is bool &&
             data.preferredGenres is list && data.preferredGenres.size() <= 10 &&
             (data.preferredGenres.size() == 0 || data.preferredGenres[0] is string) &&
             data.language is string && data.language.size() >= 1 && data.language.size() <= 40 &&
             data.subtitlesEnabled is bool &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidWatchlistItem(data) {
      return data.contentId is string && data.contentId.size() >= 1 && data.contentId.size() <= 128 &&
             data.mediaType in ['movie', 'series'] &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
             isValidTimestamp(data.addedAt);
    }

    function isValidPlaybackProgress(data) {
      return data.contentId is string && data.contentId.size() >= 1 && data.contentId.size() <= 128 &&
             (!('episodeId' in data) || data.episodeId == null || (data.episodeId is string && data.episodeId.size() <= 128)) &&
             (!('seasonNumber' in data) || data.seasonNumber == null || (data.seasonNumber is int && data.seasonNumber >= 0 && data.seasonNumber <= 100)) &&
             (!('episodeNumber' in data) || data.episodeNumber == null || (data.episodeNumber is int && data.episodeNumber >= 0 && data.episodeNumber <= 1000)) &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
             data.positionMs is int && data.positionMs >= 0 &&
             data.durationMs is int && data.durationMs >= 0 &&
             data.completed is bool &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidContentRating(data) {
      return data.contentId is string && data.contentId.size() >= 1 && data.contentId.size() <= 128 &&
             data.liked is int && data.liked >= -1 && data.liked <= 1 &&
             data.stars is int && data.stars >= 0 && data.stars <= 5 &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidSearchHistoryItem(data) {
      return data.query is string && data.query.size() >= 1 && data.query.size() <= 120 &&
             isValidTimestamp(data.searchedAt);
    }

    function isValidUserNotification(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.message is string && data.message.size() >= 1 && data.message.size() <= 500 &&
             (!('contentId' in data) || data.contentId == null || (data.contentId is string && data.contentId.size() <= 128)) &&
             data.read is bool &&
             isValidTimestamp(data.createdAt);
    }

    function isValidCatalogItem(data) {
      return data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
             data.synopsis is string && data.synopsis.size() >= 1 && data.synopsis.size() <= 2000 &&
             data.mediaType in ['movie', 'series'] &&
             data.genres is list && data.genres.size() >= 1 && data.genres.size() <= 8 &&
             data.genres[0] is string &&
             data.releaseYear is int && data.releaseYear >= 1900 && data.releaseYear <= 2100 &&
             data.runtimeMinutes is int && data.runtimeMinutes >= 1 && data.runtimeMinutes <= 1000 &&
             data.ageRating is string && data.ageRating.size() >= 1 && data.ageRating.size() <= 20 &&
             data.director is string && data.director.size() >= 1 && data.director.size() <= 120 &&
             data.cast is list && data.cast.size() <= 12 &&
             (data.cast.size() == 0 || data.cast[0] is string) &&
             data.posterKey is string && data.posterKey.size() <= 128 &&
             (!('posterUrl' in data) || data.posterUrl == null || (data.posterUrl is string && data.posterUrl.size() <= 1000)) &&
             data.backdropKey is string && data.backdropKey.size() <= 128 &&
             (!('backdropUrl' in data) || data.backdropUrl == null || (data.backdropUrl is string && data.backdropUrl.size() <= 1000)) &&
             (!('trailerUrl' in data) || data.trailerUrl == null || (data.trailerUrl is string && data.trailerUrl.size() <= 1000)) &&
             data.videoUrl is string && data.videoUrl.size() <= 1000 &&
             (!('videoSourceType' in data) || data.videoSourceType in ['auto', 'youtube', 'embed', 'mp4', 'hls']) &&
             (!('providerName' in data) || data.providerName == null || (data.providerName is string && data.providerName.size() <= 80)) &&
             (!('hlsUrl' in data) || data.hlsUrl == null || (data.hlsUrl is string && data.hlsUrl.size() <= 1000)) &&
             data.isFeatured is bool &&
             data.isVisible is bool &&
             data.isKidsFriendly is bool &&
             data.trendingScore is int && data.trendingScore >= 0 && data.trendingScore <= 100000 &&
             data.popularityRank is int && data.popularityRank >= 0 && data.popularityRank <= 10000 &&
             (!('tags' in data) || (data.tags is list && data.tags.size() <= 12 && (data.tags.size() == 0 || data.tags[0] is string))) &&
             (!('keywords' in data) || (data.keywords is list && data.keywords.size() <= 16 && (data.keywords.size() == 0 || data.keywords[0] is string))) &&
             (!('isStaffPick' in data) || data.isStaffPick is bool) &&
             (!('isAwardWinning' in data) || data.isAwardWinning is bool) &&
             (!('isComingSoon' in data) || data.isComingSoon is bool) &&
             (!('expectedReleaseDate' in data) || data.expectedReleaseDate == null || (data.expectedReleaseDate is string && data.expectedReleaseDate.size() <= 60)) &&
             (!('leavingSoonAt' in data) || data.leavingSoonAt == null || (data.leavingSoonAt is string && data.leavingSoonAt.size() <= 60)) &&
             (!('publisherUid' in data) || data.publisherUid == null || (data.publisherUid is string && data.publisherUid.size() <= 128)) &&
             (!('publisherName' in data) || data.publisherName == null || (data.publisherName is string && data.publisherName.size() <= 120)) &&
             (!('sourceSubmissionId' in data) || data.sourceSubmissionId == null || (data.sourceSubmissionId is string && data.sourceSubmissionId.size() <= 128)) &&
             (!('contentCategory' in data) || data.contentCategory == null || (data.contentCategory is string && data.contentCategory.size() <= 40)) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidSeason(data) {
      return data.seasonNumber is int && data.seasonNumber >= 1 && data.seasonNumber <= 100 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.year is int && data.year >= 1900 && data.year <= 2100 &&
             data.isVisible is bool &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidEpisode(data) {
      return data.seasonNumber is int && data.seasonNumber >= 1 && data.seasonNumber <= 100 &&
             data.episodeNumber is int && data.episodeNumber >= 1 && data.episodeNumber <= 1000 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
             data.synopsis is string && data.synopsis.size() >= 1 && data.synopsis.size() <= 1500 &&
             data.runtimeMinutes is int && data.runtimeMinutes >= 1 && data.runtimeMinutes <= 600 &&
             data.thumbnailKey is string && data.thumbnailKey.size() <= 128 &&
             (!('thumbnailUrl' in data) || data.thumbnailUrl == null || (data.thumbnailUrl is string && data.thumbnailUrl.size() <= 1000)) &&
             data.videoUrl is string && data.videoUrl.size() <= 1000 &&
             (!('videoSourceType' in data) || data.videoSourceType in ['auto', 'youtube', 'embed', 'mp4', 'hls']) &&
             (!('providerName' in data) || data.providerName == null || (data.providerName is string && data.providerName.size() <= 80)) &&
             (!('hlsUrl' in data) || data.hlsUrl == null || (data.hlsUrl is string && data.hlsUrl.size() <= 1000)) &&
             data.isVisible is bool &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidGenre(data) {
      return data.name is string && data.name.size() >= 1 && data.name.size() <= 60 &&
             data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 60 &&
             data.displayOrder is int && data.displayOrder >= 0 && data.displayOrder <= 1000 &&
             data.isActive is bool &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidSubscriptionPlan(data) {
      return data.tierCode is string && data.tierCode.size() >= 1 && data.tierCode.size() <= 40 &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 60 &&
             data.description is string && data.description.size() >= 1 && data.description.size() <= 500 &&
             data.isPermanentFree is bool &&
             data.isActive is bool &&
             (!('isPublic' in data) || data.isPublic is bool) &&
             (!('isArchived' in data) || data.isArchived is bool) &&
             (!('billingInterval' in data) || data.billingInterval in ['free', 'monthly', 'yearly', 'custom']) &&
             data.monthlyPriceCents is int && data.monthlyPriceCents >= 0 && data.monthlyPriceCents <= 1000000 &&
             data.yearlyPriceCents is int && data.yearlyPriceCents >= 0 && data.yearlyPriceCents <= 10000000 &&
             data.maxQuality in ['Auto', '480p', '720p', '1080p', '4K'] &&
             data.maxSimultaneousStreams is int && data.maxSimultaneousStreams >= 1 && data.maxSimultaneousStreams <= 20 &&
             data.maxProfiles is int && data.maxProfiles >= 1 && data.maxProfiles <= 10 &&
             data.featuresSummary is list && data.featuresSummary.size() <= 20 &&
             (data.featuresSummary.size() == 0 || data.featuresSummary[0] is string) &&
             data.displayOrder is int && data.displayOrder >= 0 && data.displayOrder <= 100 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidPlanFeature(data) {
      return data.featureKey is string && data.featureKey.size() >= 1 && data.featureKey.size() <= 64 &&
             data.label is string && data.label.size() >= 1 && data.label.size() <= 100 &&
             data.description is string && data.description.size() >= 1 && data.description.size() <= 300 &&
             data.enabled is bool &&
             data.displayOrder is int && data.displayOrder >= 0 && data.displayOrder <= 100 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidUserSubscription(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.planId is string && data.planId.size() >= 1 && data.planId.size() <= 64 &&
             data.planName is string && data.planName.size() >= 1 && data.planName.size() <= 60 &&
             data.status in ['active', 'paused', 'expired', 'canceled'] &&
             data.isPermanentFree is bool &&
             data.assignedBy is string && data.assignedBy.size() >= 1 && data.assignedBy.size() <= 128 &&
             isValidTimestamp(data.startsAt) &&
             (!('expiresAt' in data) || data.expiresAt == null || data.expiresAt is timestamp) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidHomepageSettings(data) {
      return data.maxItemsPerRow is int && data.maxItemsPerRow >= 3 && data.maxItemsPerRow <= 30 &&
             data.maxBecauseYouWatchedRows is int && data.maxBecauseYouWatchedRows >= 0 && data.maxBecauseYouWatchedRows <= 10 &&
             data.enabledGenres is list && data.enabledGenres.size() <= 50 &&
             (data.enabledGenres.size() == 0 || data.enabledGenres[0] is string) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidHomepageRowRule(data) {
      return data.rowKey is string && data.rowKey.size() >= 1 && data.rowKey.size() <= 80 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.enabled is bool &&
             data.displayOrder is int && data.displayOrder >= 0 && data.displayOrder <= 200 &&
             data.maxItems is int && data.maxItems >= 1 && data.maxItems <= 30 &&
             data.personalized is bool &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidPublisherApplication(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.publisherName is string && data.publisherName.size() <= 120 &&
             data.contactEmail is string && data.contactEmail.size() <= 200 &&
             data.organizationDescription is string && data.organizationDescription.size() <= 1000 &&
             data.intendedContentDetails is string && data.intendedContentDetails.size() <= 1000 &&
             data.status in ['none', 'pending', 'under_review', 'approved', 'rejected'] &&
             data.reviewerNotes is string && data.reviewerNotes.size() <= 2000 &&
             (!('reviewedByUid' in data) || data.reviewedByUid == null || (data.reviewedByUid is string && data.reviewedByUid.size() <= 128)) &&
             isValidTimestamp(data.submittedAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidContentSubmission(data) {
      return data.publisherUid is string && data.publisherUid.size() >= 1 && data.publisherUid.size() <= 128 &&
             data.publisherName is string && data.publisherName.size() >= 1 && data.publisherName.size() <= 120 &&
             data.mediaType in ['movie', 'series', 'documentary', 'short_film'] &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
             data.synopsis is string && data.synopsis.size() >= 1 && data.synopsis.size() <= 2000 &&
             data.genres is list && data.genres.size() >= 1 && data.genres.size() <= 8 &&
             data.genres[0] is string &&
             data.releaseYear is int && data.releaseYear >= 1900 && data.releaseYear <= 2100 &&
             data.runtimeMinutes is int && data.runtimeMinutes >= 1 && data.runtimeMinutes <= 1000 &&
             data.ageRating is string && data.ageRating.size() >= 1 && data.ageRating.size() <= 20 &&
             data.directorOrCreator is string && data.directorOrCreator.size() >= 1 && data.directorOrCreator.size() <= 120 &&
             data.cast is list && data.cast.size() <= 12 &&
             data.posterKey is string && data.posterKey.size() <= 128 &&
             (!('posterUrl' in data) || data.posterUrl == null || (data.posterUrl is string && data.posterUrl.size() <= 1000)) &&
             data.backdropKey is string && data.backdropKey.size() <= 128 &&
             (!('backdropUrl' in data) || data.backdropUrl == null || (data.backdropUrl is string && data.backdropUrl.size() <= 1000)) &&
             (!('trailerUrl' in data) || data.trailerUrl == null || (data.trailerUrl is string && data.trailerUrl.size() <= 1000)) &&
             data.videoUrl is string && data.videoUrl.size() <= 1000 &&
             (!('videoSourceType' in data) || data.videoSourceType in ['auto', 'youtube', 'embed', 'mp4', 'hls']) &&
             (!('providerName' in data) || data.providerName == null || (data.providerName is string && data.providerName.size() <= 80)) &&
             (!('hlsUrl' in data) || data.hlsUrl == null || (data.hlsUrl is string && data.hlsUrl.size() <= 1000)) &&
             data.isKidsFriendly is bool &&
             (!('tags' in data) || (data.tags is list && data.tags.size() <= 12)) &&
             (!('seasons' in data) || (data.seasons is list && data.seasons.size() <= 30)) &&
             data.distributionAuthorized is bool &&
             data.distributionRightsStatement is string && data.distributionRightsStatement.size() <= 500 &&
             data.reviewStatus in ['pending_review', 'under_review', 'approved', 'changes_requested', 'rejected'] &&
             data.privateReviewerNotes is string && data.privateReviewerNotes.size() <= 2000 &&
             (!('lastReviewedByUid' in data) || data.lastReviewedByUid == null || (data.lastReviewedByUid is string && data.lastReviewedByUid.size() <= 128)) &&
             (!('lastReviewedAt' in data) || data.lastReviewedAt == null || data.lastReviewedAt is timestamp) &&
             (!('publishedCatalogId' in data) || data.publishedCatalogId == null || (data.publishedCatalogId is string && data.publishedCatalogId.size() <= 128)) &&
             data.isRevision is bool &&
             data.revisionNumber is int && data.revisionNumber >= 1 && data.revisionNumber <= 1000 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidReviewDecision(data) {
      return data.submissionId is string && data.submissionId.size() >= 1 && data.submissionId.size() <= 128 &&
             data.reviewerUid is string && data.reviewerUid.size() >= 1 && data.reviewerUid.size() <= 128 &&
             data.reviewerRole in ['admin', 'owner'] &&
             data.decision in ['under_review', 'approved', 'changes_requested', 'rejected'] &&
             data.notes is string && data.notes.size() <= 2000 &&
             data.videoSourceVerified is bool &&
             data.rightsConfirmed is bool &&
             data.metadataVerified is bool &&
             isValidTimestamp(data.createdAt);
    }

    function isValidPlatformSettings(data) {
      return data.freeAccessEnabled is bool &&
             data.freeAccessNotice is string && data.freeAccessNotice.size() <= 400 &&
             data.updatedByUid is string && data.updatedByUid.size() >= 1 && data.updatedByUid.size() <= 128 &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidAuditLogEntry(data) {
      return data.actorUid is string && data.actorUid.size() >= 1 && data.actorUid.size() <= 128 &&
             data.actorRole in ['owner', 'admin'] &&
             data.action is string && data.action.size() >= 1 && data.action.size() <= 120 &&
             (!('targetUid' in data) || data.targetUid == null || (data.targetUid is string && data.targetUid.size() <= 128)) &&
             (!('targetContentId' in data) || data.targetContentId == null || (data.targetContentId is string && data.targetContentId.size() <= 128)) &&
             (!('targetSubscriptionId' in data) || data.targetSubscriptionId == null || (data.targetSubscriptionId is string && data.targetSubscriptionId.size() <= 128)) &&
             data.previousValue is string && data.previousValue.size() <= 500 &&
             data.newValue is string && data.newValue.size() <= 500 &&
             data.details is string && data.details.size() <= 1000 &&
             isValidTimestamp(data.createdAt);
    }

    // --- Collection Rules ---

    // Immutable trusted Owner registry (cannot be altered or deleted by any client or Admin)
    match /owners/{ownerUid} {
      allow get: if isValidId(ownerUid) && (isAccountOwner(ownerUid) || isAdmin());
      allow list: if isAdmin();

      allow create: if isValidId(ownerUid) &&
                       isBootstrappedOwner() &&
                       request.auth.uid == ownerUid &&
                       !exists(/databases/$(database)/documents/owners/$(ownerUid)) &&
                       incoming().uid == ownerUid &&
                       incoming().keys().hasAll(['uid', 'email', 'establishedBy', 'createdAt']) &&
                       incoming().keys().hasOnly(['uid', 'email', 'establishedBy', 'createdAt']) &&
                       isValidOwnerRecord(incoming());

      allow update: if false;
      allow delete: if false;
    }

    // Admin role registry — ONLY Platform Owner can appoint or remove Admins
    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && (isAccountOwner(adminUid) || isAdmin());
      allow list: if isAdmin();

      allow create: if isValidId(adminUid) &&
                       isPlatformOwner() &&
                       incoming().uid == adminUid &&
                       incoming().keys().hasAll(['uid', 'email', 'grantedBy', 'createdAt']) &&
                       incoming().keys().hasOnly(['uid', 'email', 'grantedBy', 'createdAt']) &&
                       isValidAdminRecord(incoming());

      allow update: if false;
      allow delete: if isValidId(adminUid) && isPlatformOwner() && !isTargetPlatformOwner(adminUid);
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isAccountOwner(userId) || isAdmin());
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);

      allow create: if isValidId(userId) &&
                       isAccountOwner(userId) &&
                       incoming().userId == request.auth.uid &&
                       (
                         incoming().role in ['viewer', 'member'] ||
                         (incoming().role == 'owner' && isPlatformOwner())
                       ) &&
                       (!('publisherStatus' in incoming()) || incoming().publisherStatus == 'none') &&
                       (!('isSuspended' in incoming()) || incoming().isSuspended == false) &&
                       incoming().keys().hasAll(['userId', 'email', 'displayName', 'role', 'languagePreference', 'autoplayNext', 'defaultQuality', 'subtitlesEnabled', 'subtitleSize', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'email', 'phoneNumber', 'displayName', 'photoUrl', 'role', 'publisherStatus', 'publisherName', 'publisherAppliedAt', 'isSuspended', 'languagePreference', 'autoplayNext', 'defaultQuality', 'subtitlesEnabled', 'subtitleSize', 'createdAt', 'updatedAt']) &&
                       isValidUserAccount(incoming());

      allow update: if isValidId(userId) &&
                       isValidUserAccount(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt && (
                         // 1. Self preference update (cannot self-promote role or publisherStatus or unsuspended)
                         (isAccountOwner(userId) &&
                          incoming().role == existing().role &&
                          incoming().get('publisherStatus', 'none') == existing().get('publisherStatus', 'none') &&
                          incoming().get('isSuspended', false) == existing().get('isSuspended', false) &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'phoneNumber', 'photoUrl', 'languagePreference', 'autoplayNext', 'defaultQuality', 'subtitlesEnabled', 'subtitleSize', 'updatedAt'])) ||
                         // 2. Owner one-time self-sync to role='owner' (never downgrades, never suspends)
                         (isAccountOwner(userId) &&
                          isPlatformOwner() &&
                          incoming().role == 'owner' &&
                          incoming().get('isSuspended', false) == false &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['role', 'updatedAt'])) ||
                         // 3. Platform Owner managing any non-Owner account (can assign viewer/publisher/admin, suspend, publisherStatus)
                         (isPlatformOwner() &&
                          !isTargetPlatformOwner(userId) &&
                          incoming().role in ['viewer', 'member', 'publisher', 'admin'] &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['role', 'publisherStatus', 'publisherName', 'publisherAppliedAt', 'isSuspended', 'updatedAt'])) ||
                         // 4. Non-Owner Admin managing ordinary Viewer/Publisher accounts ONLY (NEVER Owner, NEVER Admin, NEVER promote to Admin/Owner)
                         (isAdminOnly() &&
                          !isTargetPlatformOwner(userId) &&
                          !isTargetAdmin(userId) &&
                          existing().role in ['viewer', 'member', 'publisher'] &&
                          incoming().role in ['viewer', 'member', 'publisher'] &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['role', 'publisherStatus', 'publisherName', 'publisherAppliedAt', 'isSuspended', 'updatedAt']))
                       );

      // Owner account can NEVER be deleted by any Admin; Admins can NEVER delete other Admins
      allow delete: if isValidId(userId) &&
                       !isTargetPlatformOwner(userId) && (
                         isAccountOwner(userId) ||
                         isPlatformOwner() ||
                         (isAdminOnly() && !isTargetAdmin(userId))
                       );

      match /profiles/{profileId} {
        allow get: if isValidId(userId) && isValidId(profileId) && (isAccountOwner(userId) || isAdmin());
        allow list: if isValidId(userId) && (isAccountOwner(userId) || isAdmin());

        allow create: if isValidId(userId) && isValidId(profileId) &&
                         (isAccountOwner(userId) || (isAdmin() && !isTargetPlatformOwner(userId))) &&
                         incoming().userId == userId &&
                         incoming().keys().hasAll(['userId', 'name', 'avatarKey', 'isKids', 'preferredGenres', 'language', 'subtitlesEnabled', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'name', 'avatarKey', 'isKids', 'preferredGenres', 'language', 'subtitlesEnabled', 'createdAt', 'updatedAt']) &&
                         isValidUserProfile(incoming());

        allow update: if isValidId(userId) && isValidId(profileId) &&
                         (isAccountOwner(userId) || (isAdmin() && !isTargetPlatformOwner(userId))) &&
                         isValidUserProfile(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['name', 'avatarKey', 'isKids', 'preferredGenres', 'language', 'subtitlesEnabled', 'updatedAt']);

        allow delete: if isValidId(userId) && isValidId(profileId) && (isAccountOwner(userId) || (isAdmin() && !isTargetPlatformOwner(userId)));

        match /watchlist/{contentId} {
          allow get: if isValidId(userId) && isValidId(profileId) && isValidId(contentId) && isAccountOwner(userId);
          allow list: if isValidId(userId) && isValidId(profileId) && isAccountOwner(userId);

          allow create: if isValidId(userId) && isValidId(profileId) && isValidId(contentId) &&
                           isAccountOwner(userId) &&
                           incoming().contentId == contentId &&
                           incoming().keys().hasAll(['contentId', 'mediaType', 'title', 'addedAt']) &&
                           incoming().keys().hasOnly(['contentId', 'mediaType', 'title', 'addedAt']) &&
                           isValidWatchlistItem(incoming());

          allow update: if false;
          allow delete: if isValidId(userId) && isValidId(profileId) && isValidId(contentId) && isAccountOwner(userId);
        }

        match /progress/{progressId} {
          allow get: if isValidId(userId) && isValidId(profileId) && isValidId(progressId) && isAccountOwner(userId);
          allow list: if isValidId(userId) && isValidId(profileId) && isAccountOwner(userId);

          allow create: if isValidId(userId) && isValidId(profileId) && isValidId(progressId) &&
                           isAccountOwner(userId) &&
                           incoming().keys().hasAll(['contentId', 'title', 'positionMs', 'durationMs', 'completed', 'updatedAt']) &&
                           incoming().keys().hasOnly(['contentId', 'episodeId', 'seasonNumber', 'episodeNumber', 'title', 'positionMs', 'durationMs', 'completed', 'updatedAt']) &&
                           isValidPlaybackProgress(incoming());

          allow update: if isValidId(userId) && isValidId(profileId) && isValidId(progressId) &&
                           isAccountOwner(userId) &&
                           isValidPlaybackProgress(incoming()) &&
                           incoming().contentId == existing().contentId &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['episodeId', 'seasonNumber', 'episodeNumber', 'title', 'positionMs', 'durationMs', 'completed', 'updatedAt']);

          allow delete: if isValidId(userId) && isValidId(profileId) && isValidId(progressId) && isAccountOwner(userId);
        }

        match /ratings/{contentId} {
          allow get: if isValidId(userId) && isValidId(profileId) && isValidId(contentId) && isAccountOwner(userId);
          allow list: if isValidId(userId) && isValidId(profileId) && isAccountOwner(userId);

          allow create: if isValidId(userId) && isValidId(profileId) && isValidId(contentId) &&
                           isAccountOwner(userId) &&
                           incoming().contentId == contentId &&
                           incoming().keys().hasAll(['contentId', 'liked', 'stars', 'updatedAt']) &&
                           incoming().keys().hasOnly(['contentId', 'liked', 'stars', 'updatedAt']) &&
                           isValidContentRating(incoming());

          allow update: if isValidId(userId) && isValidId(profileId) && isValidId(contentId) &&
                           isAccountOwner(userId) &&
                           isValidContentRating(incoming()) &&
                           incoming().contentId == existing().contentId &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['liked', 'stars', 'updatedAt']);

          allow delete: if isValidId(userId) && isValidId(profileId) && isValidId(contentId) && isAccountOwner(userId);
        }

        match /searchHistory/{queryId} {
          allow get: if isValidId(userId) && isValidId(profileId) && isValidId(queryId) && isAccountOwner(userId);
          allow list: if isValidId(userId) && isValidId(profileId) && isAccountOwner(userId);

          allow create: if isValidId(userId) && isValidId(profileId) && isValidId(queryId) &&
                           isAccountOwner(userId) &&
                           incoming().keys().hasAll(['query', 'searchedAt']) &&
                           incoming().keys().hasOnly(['query', 'searchedAt']) &&
                           isValidSearchHistoryItem(incoming());

          allow update: if isValidId(userId) && isValidId(profileId) && isValidId(queryId) &&
                           isAccountOwner(userId) &&
                           isValidSearchHistoryItem(incoming()) &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['query', 'searchedAt']);

          allow delete: if isValidId(userId) && isValidId(profileId) && isValidId(queryId) && isAccountOwner(userId);
        }
      }

      match /notifications/{notificationId} {
        allow get: if isValidId(userId) && isValidId(notificationId) && isAccountOwner(userId);
        allow list: if isValidId(userId) && isAccountOwner(userId);

        allow create: if isValidId(userId) && isValidId(notificationId) &&
                         (isAccountOwner(userId) || isAdmin()) &&
                         incoming().userId == userId &&
                         incoming().keys().hasAll(['userId', 'title', 'message', 'read', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'title', 'message', 'contentId', 'read', 'createdAt']) &&
                         isValidUserNotification(incoming());

        allow update: if isValidId(userId) && isValidId(notificationId) &&
                         isAccountOwner(userId) &&
                         isValidUserNotification(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['read']);

        allow delete: if isValidId(userId) && isValidId(notificationId) && isAccountOwner(userId);
      }
    }

    // Publisher/Distributor Applications (private to applicant & Admin/Owner)
    match /publisherApplications/{userId} {
      allow get: if isValidId(userId) && (isAccountOwner(userId) || isAdmin());
      allow list: if isAdmin();

      // Applicant can create own tracking record ONLY with status='pending' (NEVER 'approved')
      allow create: if isValidId(userId) &&
                       isAccountOwner(userId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().status == 'pending' &&
                       incoming().reviewerNotes == '' &&
                       (!('reviewedByUid' in incoming()) || incoming().reviewedByUid == null) &&
                       incoming().keys().hasAll(['userId', 'publisherName', 'contactEmail', 'organizationDescription', 'intendedContentDetails', 'status', 'reviewerNotes', 'submittedAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'publisherName', 'contactEmail', 'organizationDescription', 'intendedContentDetails', 'status', 'reviewerNotes', 'reviewedByUid', 'submittedAt', 'updatedAt']) &&
                       isValidPublisherApplication(incoming());

      allow update: if isValidId(userId) &&
                       isValidPublisherApplication(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().submittedAt == existing().submittedAt && (
                         // Applicant can re-apply only if previously none/rejected -> back to pending
                         (isAccountOwner(userId) &&
                          existing().status in ['none', 'rejected'] &&
                          incoming().status == 'pending' &&
                          incoming().reviewerNotes == existing().reviewerNotes &&
                          incoming().get('reviewedByUid', null) == existing().get('reviewedByUid', null) &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['publisherName', 'contactEmail', 'organizationDescription', 'intendedContentDetails', 'status', 'updatedAt'])) ||
                         // Admin/Owner reviews application
                         (isAdmin() &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'reviewerNotes', 'reviewedByUid', 'updatedAt']))
                       );

      allow delete: if false;
    }

    // Publisher Content Submissions & Revisions (NEVER readable by general Viewers)
    match /contentSubmissions/{submissionId} {
      allow get: if isValidId(submissionId) && (
        isAdmin() ||
        (isSignedIn() && resource != null && existing().publisherUid == request.auth.uid)
      );
      allow list: if isAdmin() || (isSignedIn() && resource.data.publisherUid == request.auth.uid);

      // Only approved Publishers (or Admin/Owner) can create submissions; NEVER pre-approved
      allow create: if isValidId(submissionId) &&
                       isApprovedPublisher() &&
                       incoming().publisherUid == request.auth.uid &&
                       incoming().reviewStatus == 'pending_review' &&
                       incoming().distributionAuthorized == true &&
                       incoming().privateReviewerNotes == '' &&
                       (!('lastReviewedByUid' in incoming()) || incoming().lastReviewedByUid == null) &&
                       (!('lastReviewedAt' in incoming()) || incoming().lastReviewedAt == null) &&
                       isValidContentSubmission(incoming());

      allow update: if isValidId(submissionId) &&
                       isSignedIn() &&
                       incoming().publisherUid == existing().publisherUid &&
                       incoming().createdAt == existing().createdAt && (
                         // Admin/Owner moderation decision
                         (isAdmin() &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['reviewStatus', 'privateReviewerNotes', 'lastReviewedByUid', 'lastReviewedAt', 'publishedCatalogId', 'updatedAt']) &&
                          incoming().reviewStatus in ['pending_review', 'under_review', 'approved', 'changes_requested', 'rejected'] &&
                          incoming().privateReviewerNotes is string && incoming().privateReviewerNotes.size() <= 2000 &&
                          isValidTimestamp(incoming().updatedAt)) ||
                         // Publisher editing own pending or changes_requested submission (cannot self-approve or touch reviewer notes)
                         (existing().publisherUid == request.auth.uid &&
                          existing().reviewStatus in ['pending_review', 'changes_requested'] &&
                          incoming().reviewStatus == 'pending_review' &&
                          incoming().distributionAuthorized == true &&
                          incoming().privateReviewerNotes == existing().privateReviewerNotes &&
                          incoming().get('lastReviewedByUid', null) == existing().get('lastReviewedByUid', null) &&
                          incoming().get('lastReviewedAt', null) == existing().get('lastReviewedAt', null) &&
                          incoming().get('publishedCatalogId', null) == existing().get('publishedCatalogId', null) &&
                          incoming().isRevision == existing().isRevision &&
                          incoming().revisionNumber == existing().revisionNumber &&
                          isApprovedPublisher() &&
                          isValidContentSubmission(incoming()))
                       );

      allow delete: if isValidId(submissionId) && (
        isAdmin() ||
        (isApprovedPublisher() && existing().publisherUid == request.auth.uid && existing().reviewStatus in ['pending_review', 'changes_requested', 'rejected'])
      );

      // Immutable review history for a submission
      match /reviews/{reviewId} {
        allow get: if isValidId(submissionId) && isValidId(reviewId) && (
          isAdmin() ||
          (isSignedIn() &&
           exists(/databases/$(database)/documents/contentSubmissions/$(submissionId)) &&
           get(/databases/$(database)/documents/contentSubmissions/$(submissionId)).data.publisherUid == request.auth.uid)
        );
        allow list: if isValidId(submissionId) && (
          isAdmin() ||
          (isSignedIn() &&
           exists(/databases/$(database)/documents/contentSubmissions/$(submissionId)) &&
           get(/databases/$(database)/documents/contentSubmissions/$(submissionId)).data.publisherUid == request.auth.uid)
        );

        allow create: if isValidId(submissionId) && isValidId(reviewId) &&
                         isAdmin() &&
                         incoming().submissionId == submissionId &&
                         incoming().reviewerUid == request.auth.uid &&
                         isValidReviewDecision(incoming());

        allow update: if false;
        allow delete: if false;
      }
    }

    // Public Catalog — strictly Admin/Owner writes ONLY (Publishers cannot bypass moderation)
    match /catalog/{contentId} {
      allow get: if isValidId(contentId) && isSignedIn() && (isAdmin() || (resource != null && existing().isVisible == true));
      allow list: if isSignedIn() && (isAdmin() || resource.data.isVisible == true);

      allow create: if isValidId(contentId) &&
                       isAdmin() &&
                       incoming().keys().hasAll(['title', 'synopsis', 'mediaType', 'genres', 'releaseYear', 'runtimeMinutes', 'ageRating', 'director', 'cast', 'posterKey', 'backdropKey', 'videoUrl', 'isFeatured', 'isVisible', 'isKidsFriendly', 'trendingScore', 'popularityRank', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['title', 'synopsis', 'mediaType', 'genres', 'releaseYear', 'runtimeMinutes', 'ageRating', 'director', 'cast', 'posterKey', 'posterUrl', 'backdropKey', 'backdropUrl', 'trailerUrl', 'videoUrl', 'videoSourceType', 'providerName', 'hlsUrl', 'isFeatured', 'isVisible', 'isKidsFriendly', 'trendingScore', 'popularityRank', 'tags', 'keywords', 'isStaffPick', 'isAwardWinning', 'isComingSoon', 'expectedReleaseDate', 'leavingSoonAt', 'publisherUid', 'publisherName', 'sourceSubmissionId', 'contentCategory', 'createdAt', 'updatedAt']) &&
                       isValidCatalogItem(incoming());

      allow update: if isValidId(contentId) &&
                       isAdmin() &&
                       isValidCatalogItem(incoming()) &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['title', 'synopsis', 'mediaType', 'genres', 'releaseYear', 'runtimeMinutes', 'ageRating', 'director', 'cast', 'posterKey', 'posterUrl', 'backdropKey', 'backdropUrl', 'trailerUrl', 'videoUrl', 'videoSourceType', 'providerName', 'hlsUrl', 'isFeatured', 'isVisible', 'isKidsFriendly', 'trendingScore', 'popularityRank', 'tags', 'keywords', 'isStaffPick', 'isAwardWinning', 'isComingSoon', 'expectedReleaseDate', 'leavingSoonAt', 'publisherUid', 'publisherName', 'sourceSubmissionId', 'contentCategory', 'updatedAt']);

      allow delete: if isValidId(contentId) && isAdmin();

      match /seasons/{seasonId} {
        allow get: if isValidId(contentId) && isValidId(seasonId) && isSignedIn() && (isAdmin() || (resource != null && existing().isVisible == true));
        allow list: if isValidId(contentId) && isSignedIn() && (isAdmin() || resource.data.isVisible == true);

        allow create: if isValidId(contentId) && isValidId(seasonId) &&
                         isAdmin() &&
                         exists(/databases/$(database)/documents/catalog/$(contentId)) &&
                         incoming().keys().hasAll(['seasonNumber', 'title', 'year', 'isVisible', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['seasonNumber', 'title', 'year', 'isVisible', 'createdAt', 'updatedAt']) &&
                         isValidSeason(incoming());

        allow update: if isValidId(contentId) && isValidId(seasonId) &&
                         isAdmin() &&
                         isValidSeason(incoming()) &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['seasonNumber', 'title', 'year', 'isVisible', 'updatedAt']);

        allow delete: if isValidId(contentId) && isValidId(seasonId) && isAdmin();

        match /episodes/{episodeId} {
          allow get: if isValidId(contentId) && isValidId(seasonId) && isValidId(episodeId) && isSignedIn() && (isAdmin() || (resource != null && existing().isVisible == true));
          allow list: if isValidId(contentId) && isValidId(seasonId) && isSignedIn() && (isAdmin() || resource.data.isVisible == true);

          allow create: if isValidId(contentId) && isValidId(seasonId) && isValidId(episodeId) &&
                           isAdmin() &&
                           exists(/databases/$(database)/documents/catalog/$(contentId)/seasons/$(seasonId)) &&
                           incoming().keys().hasAll(['seasonNumber', 'episodeNumber', 'title', 'synopsis', 'runtimeMinutes', 'thumbnailKey', 'videoUrl', 'isVisible', 'createdAt', 'updatedAt']) &&
                           incoming().keys().hasOnly(['seasonNumber', 'episodeNumber', 'title', 'synopsis', 'runtimeMinutes', 'thumbnailKey', 'thumbnailUrl', 'videoUrl', 'videoSourceType', 'providerName', 'hlsUrl', 'isVisible', 'createdAt', 'updatedAt']) &&
                           isValidEpisode(incoming());

          allow update: if isValidId(contentId) && isValidId(seasonId) && isValidId(episodeId) &&
                           isAdmin() &&
                           isValidEpisode(incoming()) &&
                           incoming().createdAt == existing().createdAt &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['seasonNumber', 'episodeNumber', 'title', 'synopsis', 'runtimeMinutes', 'thumbnailKey', 'thumbnailUrl', 'videoUrl', 'videoSourceType', 'providerName', 'hlsUrl', 'isVisible', 'updatedAt']);

          allow delete: if isValidId(contentId) && isValidId(seasonId) && isValidId(episodeId) && isAdmin();
        }
      }
    }

    match /genres/{genreId} {
      allow get: if isValidId(genreId) && isSignedIn() && (isAdmin() || (resource != null && existing().isActive == true));
      allow list: if isSignedIn() && (isAdmin() || resource.data.isActive == true);

      allow create: if isValidId(genreId) &&
                       isAdmin() &&
                       incoming().keys().hasAll(['name', 'slug', 'displayOrder', 'isActive', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['name', 'slug', 'displayOrder', 'isActive', 'createdAt', 'updatedAt']) &&
                       isValidGenre(incoming());

      allow update: if isValidId(genreId) &&
                       isAdmin() &&
                       isValidGenre(incoming()) &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['name', 'slug', 'displayOrder', 'isActive', 'updatedAt']);

      allow delete: if isValidId(genreId) && isAdmin();
    }

    // Subscription Plans: Viewers see only enabled, public, non-archived plans; Admin/Owner manages all
    match /subscriptionPlans/{planId} {
      allow get: if isValidId(planId) && isSignedIn() && (
        isAdmin() ||
        (resource != null && existing().isActive == true && existing().get('isPublic', true) == true && existing().get('isArchived', false) == false)
      );
      allow list: if isSignedIn() && (
        isAdmin() ||
        (resource.data.isActive == true && resource.data.isPublic == true && resource.data.isArchived == false)
      );

      allow create: if isValidId(planId) &&
                       isAdmin() &&
                       incoming().keys().hasAll(['tierCode', 'name', 'description', 'isPermanentFree', 'isActive', 'monthlyPriceCents', 'yearlyPriceCents', 'maxQuality', 'maxSimultaneousStreams', 'maxProfiles', 'featuresSummary', 'displayOrder', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['tierCode', 'name', 'description', 'isPermanentFree', 'isActive', 'isPublic', 'isArchived', 'billingInterval', 'monthlyPriceCents', 'yearlyPriceCents', 'maxQuality', 'maxSimultaneousStreams', 'maxProfiles', 'featuresSummary', 'displayOrder', 'createdAt', 'updatedAt']) &&
                       (planId != 'free' || (incoming().isPermanentFree == true && incoming().isActive == true && incoming().get('isPublic', true) == true && incoming().get('isArchived', false) == false && incoming().monthlyPriceCents == 0 && incoming().yearlyPriceCents == 0)) &&
                       isValidSubscriptionPlan(incoming());

      allow update: if isValidId(planId) &&
                       isAdmin() &&
                       isValidSubscriptionPlan(incoming()) &&
                       incoming().createdAt == existing().createdAt &&
                       (existing().isPermanentFree == false || (incoming().isPermanentFree == true && incoming().isActive == true && incoming().get('isPublic', true) == true && incoming().get('isArchived', false) == false && incoming().monthlyPriceCents == 0 && incoming().yearlyPriceCents == 0)) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['tierCode', 'name', 'description', 'isPermanentFree', 'isActive', 'isPublic', 'isArchived', 'billingInterval', 'monthlyPriceCents', 'yearlyPriceCents', 'maxQuality', 'maxSimultaneousStreams', 'maxProfiles', 'featuresSummary', 'displayOrder', 'updatedAt']);

      // Plans should be archived rather than hard-deleted to preserve user references
      allow delete: if false;

      match /features/{featureId} {
        allow get: if isValidId(planId) && isValidId(featureId) && isSignedIn();
        allow list: if isValidId(planId) && isSignedIn();

        allow create: if isValidId(planId) && isValidId(featureId) &&
                         isAdmin() &&
                         incoming().keys().hasAll(['featureKey', 'label', 'description', 'enabled', 'displayOrder', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['featureKey', 'label', 'description', 'enabled', 'displayOrder', 'createdAt', 'updatedAt']) &&
                         isValidPlanFeature(incoming());

        allow update: if isValidId(planId) && isValidId(featureId) &&
                         isAdmin() &&
                         isValidPlanFeature(incoming()) &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['featureKey', 'label', 'description', 'enabled', 'displayOrder', 'updatedAt']);

        allow delete: if isValidId(planId) && isValidId(featureId) && isAdmin();
      }
    }

    match /userSubscriptions/{userId} {
      allow get: if isValidId(userId) && (isAccountOwner(userId) || isAdmin());
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);

      allow create: if isValidId(userId) &&
                       incoming().userId == userId &&
                       incoming().keys().hasAll(['userId', 'planId', 'planName', 'status', 'isPermanentFree', 'assignedBy', 'startsAt', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'planId', 'planName', 'status', 'isPermanentFree', 'assignedBy', 'startsAt', 'expiresAt', 'createdAt', 'updatedAt']) &&
                       ((isAccountOwner(userId) &&
                         incoming().planId == 'free' &&
                         incoming().planName == 'Free' &&
                         incoming().status == 'active' &&
                         incoming().isPermanentFree == true &&
                         incoming().assignedBy in ['system', 'self'] &&
                         (!('expiresAt' in incoming()) || incoming().expiresAt == null)) ||
                        isAdmin()) &&
                       isValidUserSubscription(incoming());

      allow update: if isValidId(userId) &&
                       isValidUserSubscription(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().startsAt == existing().startsAt &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['planId', 'planName', 'status', 'isPermanentFree', 'assignedBy', 'expiresAt', 'updatedAt']) && (
                         // Admin/Owner can manually assign, activate, pause, or deactivate any user's subscription
                         isAdmin() ||
                         // Viewer can self-switch ONLY among enabled, public, non-archived plans (or cancel own non-free plan back to free)
                         (isAccountOwner(userId) &&
                          incoming().assignedBy == 'self' &&
                          incoming().status == 'active' &&
                          (!('expiresAt' in incoming()) || incoming().expiresAt == null) &&
                          exists(/databases/$(database)/documents/subscriptionPlans/$(incoming().planId)) &&
                          get(/databases/$(database)/documents/subscriptionPlans/$(incoming().planId)).data.isActive == true &&
                          get(/databases/$(database)/documents/subscriptionPlans/$(incoming().planId)).data.get('isPublic', true) == true &&
                          get(/databases/$(database)/documents/subscriptionPlans/$(incoming().planId)).data.get('isArchived', false) == false &&
                          incoming().planName == get(/databases/$(database)/documents/subscriptionPlans/$(incoming().planId)).data.name &&
                          incoming().isPermanentFree == get(/databases/$(database)/documents/subscriptionPlans/$(incoming().planId)).data.isPermanentFree)
                       );

      allow delete: if false;
    }

    match /homepageConfig/{configId} {
      allow get: if isValidId(configId) && isSignedIn();
      allow list: if isSignedIn();

      allow create, update: if isValidId(configId) &&
                               isAdmin() &&
                               incoming().keys().hasAll(['maxItemsPerRow', 'maxBecauseYouWatchedRows', 'enabledGenres', 'updatedAt']) &&
                               incoming().keys().hasOnly(['maxItemsPerRow', 'maxBecauseYouWatchedRows', 'enabledGenres', 'updatedAt']) &&
                               isValidHomepageSettings(incoming());

      allow delete: if isValidId(configId) && isAdmin();

      match /rows/{rowId} {
        allow get: if isValidId(configId) && isValidId(rowId) && isSignedIn();
        allow list: if isValidId(configId) && isSignedIn();

        allow create, update: if isValidId(configId) && isValidId(rowId) &&
                                 isAdmin() &&
                                 incoming().keys().hasAll(['rowKey', 'title', 'enabled', 'displayOrder', 'maxItems', 'personalized', 'updatedAt']) &&
                                 incoming().keys().hasOnly(['rowKey', 'title', 'enabled', 'displayOrder', 'maxItems', 'personalized', 'updatedAt']) &&
                                 isValidHomepageRowRule(incoming());

        allow delete: if isValidId(configId) && isValidId(rowId) && isAdmin();
      }
    }

    // Platform-wide settings (e.g., freeAccessEnabled)
    match /platformSettings/{settingId} {
      allow get: if isValidId(settingId) && isSignedIn();
      allow list: if isSignedIn();

      allow create, update: if isValidId(settingId) &&
                               isAdmin() &&
                               incoming().updatedByUid == request.auth.uid &&
                               incoming().keys().hasAll(['freeAccessEnabled', 'freeAccessNotice', 'updatedByUid', 'updatedAt']) &&
                               incoming().keys().hasOnly(['freeAccessEnabled', 'freeAccessNotice', 'updatedByUid', 'updatedAt']) &&
                               isValidPlatformSettings(incoming());

      allow delete: if false;
    }

    // Immutable Audit Logs — strictly readable and append-only by Owner/Admin; ZERO access for Viewer/Publisher
    match /auditLogs/{logId} {
      allow get: if isValidId(logId) && isAdmin();
      allow list: if isAdmin();

      allow create: if isValidId(logId) &&
                       isAdmin() &&
                       incoming().actorUid == request.auth.uid &&
                       ((isPlatformOwner() && incoming().actorRole == 'owner') ||
                        (!isPlatformOwner() && incoming().actorRole == 'admin')) &&
                       incoming().keys().hasAll(['actorUid', 'actorRole', 'action', 'previousValue', 'newValue', 'details', 'createdAt']) &&
                       incoming().keys().hasOnly(['actorUid', 'actorRole', 'action', 'targetUid', 'targetContentId', 'targetSubscriptionId', 'previousValue', 'newValue', 'details', 'createdAt']) &&
                       isValidAuditLogEntry(incoming());

      allow update: if false;
      allow delete: if false;
    }
  }
}
